# ==============================================================================
# RE-VOLVE: Vehicle Retirement & Environmental Intelligence System
# Environment Variable Configuration Template
# ==============================================================================

# Database Connection (Required)
# ------------------------------------------------------------------------------
# For Supabase (Recommended - Transaction Pooler on port 6543):
# DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
#
# For Local PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
DATABASE_URL=

# Security & Admin Access (Optional / Recommended in Production)
# ------------------------------------------------------------------------------
# Secret key required to authorize destructive operations in production (e.g., reset, bulk import delete)
ADMIN_API_KEY=

# AWS Adapters (Optional)
# ------------------------------------------------------------------------------
# Leave blank to run fully local (local filesystem adapter under data/uploads, console logs)
# Never expose secrets in client-side NEXT_PUBLIC_* variables.
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
